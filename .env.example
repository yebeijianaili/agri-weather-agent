# This project reads process environment variables; copy these values into the
# shell/start script or load them with your own environment manager.

# Optional: override the SQLite database location.
AGRI_DB_PATH=data\agri_weather.db

# Local Agent runtime. The code default, this template and the standard start
# script all enable Ollama with a 60-second timeout for first-load latency.
# Rules are used only as the automatic fallback for model failures.
AGRI_AGENT_PROVIDER=ollama
AGRI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGRI_OLLAMA_MODEL=qwen2.5:3b
AGRI_OLLAMA_TIMEOUT_SECONDS=60
AGRI_AGENT_FALLBACK=rules
